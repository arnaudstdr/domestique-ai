# Strava API — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost/exchange_token

# FTP (Functional Threshold Power) en watts — utilisé pour le calcul du TSS
STRAVA_FTP=250

# Mistral API — https://console.mistral.ai/
MISTRAL_API_KEY=

# Optionnel : chemin custom de la base SQLite (sinon ./data/strava_activities.db)
# DOMESTIQUE_AI_DB_PATH=
